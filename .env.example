# Copy this file to .env and fill in real values. Never commit .env.
# In production (Render, Fly, etc.), set these as environment variables in
# the host's dashboard instead of using a .env file.

# REQUIRED — Anthropic API key for the AI tutor "Max".
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# REQUIRED for production — Resend API key for sending verification codes.
# Without this, codes are printed to the server console (dev mode only).
# Get one at: https://resend.com → API Keys
RESEND_API_KEY=re_your-key-here

# OPTIONAL — From address for verification emails.
# Default is Resend's shared sandbox "onboarding@resend.dev", which only sends
# to your own Resend signup email. For real production, verify your domain
# in Resend first, then set this to a verified address.
EMAIL_FROM=Atrium Institute <hello@atriuminstitute.com>

# OPTIONAL — Port to listen on (host services usually set this themselves).
PORT=8765

# DATABASE_URL — Postgres connection string. When set, the app uses
# Postgres for users, sessions, codes, and progress (recommended for
# production; required on Render because the disk is ephemeral). When
# unset, the app falls back to a JSON file at DB_PATH (good for local
# development without spinning up Postgres).
#
# Render Postgres: copy the "Internal Database URL" from your Render
# Postgres service into this var on the web service. Apply the schema
# once with `node tools/migrate.js` (using the External URL locally,
# since the Internal URL is only reachable from inside Render).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# OPTIONAL — JSON-file DB path, only used when DATABASE_URL is unset.
# Default: ./data.json
# DB_PATH=./data.json

# OPTIONAL — Spend protections for the Claude API proxy.
RATE_LIMIT_PER_HOUR=30
DAILY_REQUEST_CAP=1000
